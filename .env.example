# ============================================================
# NIE-Vault Configuration Template
# ============================================================

# Database Configuration (Local MySQL or Amazon RDS MySQL Endpoint)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lost_and_found
DB_CONN_LIMIT=10

# Application Settings
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# Amazon Web Services (AWS) Configuration
# Set AWS_S3_BUCKET to enable direct S3 image uploads.
# (If not provided, files will be saved locally in uploads/)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-nie-vault-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Email Notifications (Gmail SMTP or Amazon SES SMTP)
# For Amazon SES: SMTP_HOST=email-smtp.ap-south-1.amazonaws.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM="NIE-Vault <your_email@example.com>"
